# ==============================================================================
# UNTITLED JUDGE - ENVIRONMENT CONFIGURATION TEMPLATE (.env)
# ==============================================================================
# Copy this template to .env before starting the application:
#   cp .env.example .env
#
# Generate cryptographically secure 32-byte secret keys with:
#   openssl rand -hex 32
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. APPLICATION & DOMAIN CONFIGURATION
# ------------------------------------------------------------------------------
# Domain name for Caddy automatic HTTPS certificates (omit https://)
# Example: judge.yourdomain.com or localhost
DOMAIN=localhost

# Canonical origin URL (including protocol) for redirects, CORS, and auth
# Example: https://judge.yourdomain.com (or http://localhost:5173 for local dev)
PUBLIC_ORIGIN=http://localhost:5173

# ------------------------------------------------------------------------------
# 2. DATABASE CONFIGURATION (PostgreSQL 16)
# ------------------------------------------------------------------------------
# Credentials for local Docker / self-hosted PostgreSQL container
POSTGRES_DB=untitled_judge
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres_password_replace_me

# Prisma Connection String
# Option A - Local Docker / self-hosted container:
#   DATABASE_URL="postgresql://postgres:postgres_password_replace_me@localhost:5433/untitled_judge?schema=public"
# Option B - Neon / Supabase Serverless PostgreSQL (Recommended for Vercel):
#   DATABASE_URL="postgresql://username:password@ep-your-pooler.region.neon.tech/neondb?sslmode=require"
DATABASE_URL="postgresql://postgres:postgres_password_replace_me@localhost:5433/untitled_judge?schema=public"

# ------------------------------------------------------------------------------
# 3. REDIS CONFIGURATION (Redis 7.2)
# ------------------------------------------------------------------------------
# Redis password (only required if EXECUTION_ENGINE="judge0")
REDIS_PASSWORD=redis_password_replace_me
REDIS_URL="redis://:redis_password_replace_me@localhost:6379"

# ------------------------------------------------------------------------------
# 4. CODE EXECUTION ENGINE (PISTON vs JUDGE0)
# ------------------------------------------------------------------------------
# Engine selection:
# - 'piston' (Recommended: lightweight, low RAM, ideal for VM or serverless)
# - 'judge0' (Full sandbox with queues, requires Redis + Postgres workers)
EXECUTION_ENGINE="piston"

# Set to "true" for serverless platforms (Vercel, AWS Lambda) for synchronous runs.
# Set to "false" for persistent servers (VM, Docker).
SERVERLESS="false"

# --- Piston Configuration (When EXECUTION_ENGINE="piston") ---
# URL pointing to your Piston API instance (public or self-hosted)
# Example: http://your-server-ip:2000 or https://emkc.org/api/v2/piston
PISTON_URL="http://localhost:2000"

# Optional API authorization key (only needed if using a restricted/whitelisted instance)
PISTON_API_KEY=""

# --- Judge0 Configuration (When EXECUTION_ENGINE="judge0") ---
JUDGE0_URL="http://localhost:2358"
JUDGE0_TOKEN="judge0_secret_token_replace_me"
WEBHOOK_SECRET="judge0_webhook_secret_hmac_32_chars_replace_me"

# ------------------------------------------------------------------------------
# 5. BETTER AUTH (AUTHENTICATION & SESSIONS)
# ------------------------------------------------------------------------------
# Cryptographically strong secret key used for signing session tokens and encryption.
# MUST be at least 32 characters long. Generate with: openssl rand -hex 32
BETTER_AUTH_SECRET="untitled_judge_super_secure_random_key_min_32_chars"

# Canonical URL where auth endpoints are mounted (must match PUBLIC_ORIGIN)
BETTER_AUTH_URL="http://localhost:5173"

# ------------------------------------------------------------------------------
# 6. GOOGLE OAUTH 2.0 (OPTIONAL)
# ------------------------------------------------------------------------------
# Obtain from Google Cloud Console: https://console.cloud.google.com/apis/credentials
# Authorized redirect URI: https://<YOUR_DOMAIN>/api/auth/callback/google
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# ------------------------------------------------------------------------------
# 7. SMTP EMAIL NOTIFICATIONS / OTP (OPTIONAL)
# ------------------------------------------------------------------------------
# Configure to send 6-digit email confirmation codes and password resets.
SMTP_HOST=""
SMTP_PORT=587
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="Untitled Judge <no-reply@yourdomain.com>"

# ------------------------------------------------------------------------------
# 8. STORAGE CONFIGURATION
# ------------------------------------------------------------------------------
# Directory where Content-Addressed Storage (CAS) testcases and statement PDFs are stored.
# Default: ./storage (or /app/storage inside Docker)
STORAGE_DIR="./storage"
