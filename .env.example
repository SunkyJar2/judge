# ==============================================================================
# UNTITLED JUDGE - PRODUCTION ENVIRONMENT TEMPLATE (.env)
# ==============================================================================
# Duplicate this file to .env on your server and populate each value:
#   cp .env.example .env
#
# Generate cryptographically secure keys with:
#   openssl rand -hex 32
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. APPLICATION & DOMAIN CONFIGURATION
# ------------------------------------------------------------------------------
# The fully qualified domain name pointing to your server (without https://)
# Used by Caddy to automatically provision Let's Encrypt TLS certificates.
# Example: judge.youruniversity.edu or 20.123.45.67.nip.io
DOMAIN=localhost

# The canonical public origin URL (with protocol) used for redirects and OAuth
# Example: https://judge.youruniversity.edu (or http://localhost:5173 for local dev)
PUBLIC_ORIGIN=http://localhost:5173

# ------------------------------------------------------------------------------
# 2. DATABASE CONFIGURATION (PostgreSQL 16)
# ------------------------------------------------------------------------------
# For Azure VM (Docker Compose):
#   Points to the internal 'db' container or host port 5433
POSTGRES_DB=untitled_judge
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres_super_secure_password_replace_me

# Prisma Connection URL
# If running through docker-compose.prod.yml:
#   DATABASE_URL="postgresql://postgres:postgres_super_secure_password_replace_me@db:5432/untitled_judge?schema=public"
# If running outside docker (e.g. host app or Vercel connecting to Azure PostgreSQL):
DATABASE_URL="postgresql://postgres:postgres_super_secure_password_replace_me@localhost:5433/untitled_judge?schema=public"

# ------------------------------------------------------------------------------
# 3. REDIS CONFIGURATION (Redis 7.2)
# ------------------------------------------------------------------------------
# Redis password (must match REDIS_PASSWORD in judge0.conf)
REDIS_PASSWORD=judge0_redis_secret_replace_me

# Redis connection URL
# If running through docker-compose.prod.yml:
#   REDIS_URL="redis://:judge0_redis_secret_replace_me@redis:6379"
# If running on host or connecting externally:
REDIS_URL="redis://:judge0_redis_secret_replace_me@localhost:6379"

# ------------------------------------------------------------------------------
# 4. CODE EXECUTION ENGINE (JUDGE0 vs PISTON)
# ------------------------------------------------------------------------------
# Choose 'judge0' (default for Docker/VM) or 'piston' (for serverless/Vercel)
EXECUTION_ENGINE="judge0"

# Set to 'true' if deployed on Vercel or AWS Lambda to force synchronous evaluation
SERVERLESS="false"

# --- Judge0 Configuration (When EXECUTION_ENGINE="judge0") ---
JUDGE0_URL="http://localhost:2358"
JUDGE0_TOKEN="judge0_secret_token_123"
WEBHOOK_SECRET="judge0_webhook_secret_hmac_32_chars_long_key"

# --- Piston Configuration (When EXECUTION_ENGINE="piston") ---
# URL of Piston API instance (public with whitelist key, or self-hosted container)
# E.g. https://emkc.org/api/v2/piston or https://piston.yourdomain.com
PISTON_URL="https://emkc.org/api/v2/piston"
# Optional authorization key for Piston (required if using emkc.org whitelist)
PISTON_API_KEY=""

# ------------------------------------------------------------------------------
# 5. BETTER AUTH (AUTHENTICATION & SESSIONS)
# ------------------------------------------------------------------------------
# Cryptographically strong secret key used for signing session tokens and encryption.
# MUST be at least 32 characters long.
# Generate with: openssl rand -hex 32
BETTER_AUTH_SECRET="untitled_judge_super_secure_random_key_min_32_chars"

# Canonical URL where Better Auth endpoints are mounted
# Must match PUBLIC_ORIGIN in production
BETTER_AUTH_URL="http://localhost:5173"

# ------------------------------------------------------------------------------
# 6. GOOGLE OAUTH 2.0 (OPTIONAL)
# ------------------------------------------------------------------------------
# If enabling "Sign in with Google", obtain these from Google Cloud Console:
# https://console.cloud.google.com/apis/credentials
# Authorized redirect URI: https://<YOUR_DOMAIN>/api/auth/callback/google
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# ------------------------------------------------------------------------------
# 7. SMTP EMAIL NOTIFICATIONS / OTP (OPTIONAL)
# ------------------------------------------------------------------------------
# Configure to send 6-digit email confirmation codes and password resets.
# Works with Gmail (App Password), SendGrid, AWS SES, Mailgun, etc.
SMTP_HOST=""
SMTP_PORT=587
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="Untitled Judge <no-reply@yourdomain.com>"

# ------------------------------------------------------------------------------
# 8. STORAGE CONFIGURATION
# ------------------------------------------------------------------------------
# Directory where Content-Addressed Storage (CAS) testcases and statement PDFs are stored.
# Default: ./storage (or /app/storage inside Docker)
STORAGE_DIR="./storage"
