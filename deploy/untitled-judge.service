[Unit]
Description=Untitled Judge Web
After=network.target

[Service]
Type=simple
User=judgeapp
Group=judgeapp
WorkingDirectory=/opt/untitled-judge
Environment=HOME=/var/lib/untitled-judge
Environment=XDG_RUNTIME_DIR=/run/user/997
Environment=DBUS_SESSION_BUS_ADDRESS=unix:path=/run/user/997/bus
Environment=PORT=4173
Environment=DATA_DIR=/var/lib/untitled-judge/data
Environment=TMPDIR=/var/lib/untitled-judge/tmp
Environment=CONTAINER_RUNTIME=/usr/bin/podman
Environment=JUDGE_SANDBOX_IMAGE=untitled-judge-sandbox:latest
Environment=PUBLIC_ORIGIN=https://untitledjudgeweb.duckdns.org
Environment=COOKIE_SECURE=true
ExecStart=/usr/local/bin/node /opt/untitled-judge/server.js
Restart=on-failure
RestartSec=3
UMask=0077
ProtectSystem=strict
ProtectHome=read-only
PrivateTmp=true
PrivateDevices=true
ProtectKernelTunables=true
ProtectKernelModules=true
LockPersonality=true
RestrictRealtime=true
ReadWritePaths=/run/user/997 /var/lib/untitled-judge

[Install]
WantedBy=multi-user.target
